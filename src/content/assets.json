  "light": {
    "_note": "One sun from the upper left, in the morning: every shadow falls to the lower right (#89). Colours mix in 8-bit sRGB, each channel rounding half to even. A top face is its colour mixed with `topFace.light` of `sun`, with a rim mixed with `topFace.rim.light` of `sun`, `topFace.rim.width` deep, along its front edge. A lit side is its colour, a gradient from `litSide.topLight` of `sun` at the top to `litSide.footSlate` of `slate` at the foot. A shade side is its colour mixed with `shadeSide.slate` of `slate`. Cast shadows are `slate` shapes drawn in one layer, blurred by `castShadow.blur` pixels, then shown at `castShadow.opacity`, so overlaps never double; each reaches right by `reach` and down by `drop` of its caster's height. Contact shadows are soft ellipses `contactShadow.depth` as deep as they are wide, at their kind's opacity. Ledges throw `ledgeShadow.opacity` of slate on the wall under them, fading to nothing over their depth in pixels. Material lines (bricks, tiles, the asphalt's speckle, the leaves) show at `material.lineOpacity`, in `sun` or `slate`. Over the world only, never over the panels: the painted unevenness (smooth noise, `cells` blotches across) in soft light, the grain (noise `size` pixels square, tiled) in overlay, each around mid-grey by `amplitude` of the full range and seeded by `seed`; the vignette in `vignette.color` (a palette colour), 0 inside `clear` of the radius and `opacity` at the corners; and a warm glow of `sun` from the upper left corner, `opacity` there and gone by `reach` of the diagonal. The simple visual effects drop the unevenness, the grain and the blur.",
    "sun": "#FFF1CF",
    "slate": "#34404F",
    "topFace": { "light": 0.22, "rim": { "light": 0.5, "width": 2 } },
    "litSide": { "topLight": 0.26, "footSlate": 0.3 },
    "shadeSide": { "slate": 0.4 },
    "castShadow": { "opacity": 0.38, "blur": 2, "reach": 0.36, "drop": 0.08 },
    "contactShadow": {
      "depth": 0.26,
      "opacity": {
        "person": 0.5,
        "wheel": 0.55,
        "tree": 0.45,
        "lampPost": 0.5,
        "prop": 0.5
      }
    },
    "ledgeShadow": {
      "opacity": 0.55,
      "depth": {
        "cornice": 30,
        "balcony": 26,
        "sill": 20,
        "awning": 28,
        "curb": 14
      }
    },
    "material": {
      "lineOpacity": { "min": 0.12, "max": 0.2 },
      "brick": {
        "width": 24,
        "height": 9,
        "line": 2,
        "tone": "slate",
        "seed": 89
      },
      "tile": {
        "width": 96,
        "height": 25,
        "line": 2,
        "tone": "slate",
        "seed": 90
      },
      "speckle": { "size": 64, "count": 90, "tone": "sun", "seed": 91 }
    },
    "unevenness": {
      "blend": "soft-light",
      "opacity": 0.3,
      "cells": 6,
      "amplitude": 0.5,
      "seed": 92
    },
    "grain": {
      "blend": "overlay",
      "opacity": 0.4,
      "size": 128,
      "amplitude": 0.35,
      "seed": 93
    },
    "vignette": { "color": "ink", "opacity": 0.26, "clear": 0.62 },
    "glow": { "opacity": 0.18, "reach": 0.7 },
    "shadowLayer": "shadows"
  },
