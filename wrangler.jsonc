{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magnat",
  "compatibility_date": "2026-10-13",
  // Static game, no Worker script: Cloudflare serves dist/ directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Version (preview) links for pull request builds. Set explicitly: when the
  // key is omitted, Wrangler keeps whatever the dashboard has.
  "preview_urls": true,
}
